{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:11434/*" }]
    }
  ]
}
